{
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vitepress build docs",
    "build:lock": "npm run build && node scripts/staticrypt-build.mjs",
    "lock": "node scripts/staticrypt-build.mjs",
    "preview": "vitepress preview docs",
    "font:subset": "bash scripts/subset-fonts.sh",
    "math:css": "node scripts/gen-math-css.mjs",
    "dev:qr": "qrdev vitepress dev docs --host 0.0.0.0"
  },
  "dependencies": {
    "typescript": "^5.1.6",
    "vitepress": "^1.6.4",
    "vitepress-plugin-back2top": "^0.1.5",
    "windicss": "^3.5.6"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "^4.3.2",
    "qrdev": "^1.1.1",
    "staticrypt": "^3.5.4",
    "unocss": "^66.12.0",
    "vitepress-plugin-abbr": "^0.11.0"
  }
}
